{
    "model": {
        "name": "vgg16_bn",
        "parameters": {
            "num_classes": 10
        }
    },
    "dense_tag": "vgg16_bn_cifar10",
    "training": {
        "learning_rate": 0.001,
        "finetune_epochs": 5,
        "optimizer": "sgd",
        "loss_function": "cross_entropy",
        "scheduler": {
            "type": "MultiStepLR",
            "step_size": [1000, 2000],
            "gamma": 0.1
        },
        "weight_decay": 0.0001,
        "momentum": 0.9,
        "rho": 0.5
    },
    "dataset": {
        "name": "cifar10",
        "batch_size": 128
    },
    "pruning_ratios": [0.5, 0.7, 0.9]
}
